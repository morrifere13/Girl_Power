# =================================
# GIRL POWER APP - Configuration Production
# =================================

# ---------------------------------
# Base de Données MySQL (Production)
# ---------------------------------
# Utilisez les credentials de votre base de données de production
DB_HOST=your-production-db-host.com
DB_USER=your_db_user
DB_PASSWORD=your_secure_db_password
DB_NAME=girl_power_db
DB_PORT=3306

# ---------------------------------
# Sécurité & Authentification
# ---------------------------------
# IMPORTANT: Utilisez un secret différent en production
# Générer: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-production-jwt-secret-32-characters-minimum
JWT_EXPIRES_IN=24h

# ---------------------------------
# Application
# ---------------------------------
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://invitation-mariage-app.com

# ---------------------------------
# Email (Nodemailer)
# ---------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM="Girl Power <noreply@girlpower.org>"

# ---------------------------------
# Upload de Fichiers
# ---------------------------------
UPLOAD_DIR=uploads
MAX_FILE_SIZE=20971520

# ---------------------------------
# Rate Limiting
# ---------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=5

# ---------------------------------
# CORS
# ---------------------------------
ALLOWED_ORIGINS=https://invitation-mariage-app.com,https://www.invitation-mariage-app.com

# ---------------------------------
# Logging
# ---------------------------------
LOG_LEVEL=info
LOG_FILE=logs/app.log

# ---------------------------------
# Backup Database
# ---------------------------------
BACKUP_DIR=backups
BACKUP_SCHEDULE=0 2 * * *
