# =================================
# GIRL POWER APP - Configuration
# =================================
# Copiez ce fichier vers .env et remplissez les valeurs

# ---------------------------------
# Base de Données MySQL
# ---------------------------------
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=girl_power_db
DB_PORT=3306

# ---------------------------------
# Sécurité & Authentification
# ---------------------------------
# IMPORTANT: Générez un secret aléatoire de 32+ caractères
# Exemple: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ae854f3405d204f1bac04ca59c87bfd7b2135ffef2e52cfc24cb6767a0e819b9
JWT_EXPIRES_IN=24h

# ---------------------------------
# Application
# ---------------------------------
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# ---------------------------------
# Email (Nodemailer)
# ---------------------------------
# Pour Gmail, utilisez un "App Password" : https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM="Girl Power <noreply@girlpower.org>"

# ---------------------------------
# Upload de Fichiers
# ---------------------------------
UPLOAD_DIR=uploads
MAX_FILE_SIZE=20971520
# 20MB = 20 * 1024 * 1024 bytes

# ---------------------------------
# Rate Limiting
# ---------------------------------
RATE_LIMIT_WINDOW_MS=900000
# 15 minutes = 15 * 60 * 1000
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_AUTH_MAX=20

# ---------------------------------
# CORS
# ---------------------------------
# En production, listez les domaines autorisés séparés par des virgules
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------
# Logging (Optionnel)
# ---------------------------------
LOG_LEVEL=info
LOG_FILE=logs/app.log

# ---------------------------------
# Backup Database (Optionnel)
# ---------------------------------
BACKUP_DIR=backups
BACKUP_SCHEDULE=0 2 * * *
# Cron: Tous les jours à 2h du matin

# Chemin vers mysqldump (Windows)
# XAMPP: C:\xampp\mysql\bin\mysqldump.exe
# WAMP: C:\wamp64\bin\mysql\mysql8.0.31\bin\mysqldump.exe
# MySQL Server: C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe
MYSQLDUMP_PATH=C:\wamp64\bin\mysql\mysql8.0.31\bin\mysqldump.exe
